# Playwright dependencies and local QA artifacts
node_modules/
playwright-report/
test-results/
blob-report/
debug.log
.wrangler/preview-dry-run/
.wrangler/production-dry-run/

# Brand, marketing and logo source assets. Kept on disk but out of the repo:
# they are large binaries (~24MB) with no build-time role. Deployment already
# excludes them via .assetsignore.
brand/
marketing/
On My Way 로고/

# 검증용 Capacitor 셸의 생성물. 셋 다 mobile/scripts/prepare.mjs와 `cap add android`가
# 만든다. 네이티브 프로젝트를 커밋하지 않는 이유는 mobile/README.md에 적었다.
mobile/android/
mobile/www/
mobile/capacitor.config.json

# Local backups, agent work dirs, generated outputs (never commit)
.backups/
.patch-backups/
# wrangler dev가 만드는 로컬 miniflare 상태(KV·DO·캐시 sqlite).
.wrangler/
.codex-artifacts/
.codex-backups/
.worktrees/
# 기기 검증용으로 내려받는 빌드 산출물. 한 벌에 15MB 넘는다.
apk/
