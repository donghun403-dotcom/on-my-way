{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "on-my-way",
  "main": "./worker.mjs",
  "compatibility_date": "2026-07-11",
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "onmyway.olivenrich.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "single-page-application",
    "exclude": [".codex-artifacts"]
  },
  "vars": {
    "OPENAI_MODEL": "gpt-5.4-mini",
    "APP_ENV": "production",
    "APPLE_LOGIN_VISIBLE": "false",
    "ALLOW_DEV_LOGIN": "false",
    "ALLOW_DEMO_BILLING": "false",
    "PAYMENTS_ENABLED": "false",
    "HARD_PAYWALL_ENABLED": "false"
  },
  "kv_namespaces": [
    {
      "binding": "USERS_KV",
      "id": "04d136e6bcef4de7bb8a515856dd48f6"
    }
  ],
  // preview는 워크플로의 jq, staging은 staging-config.mjs가 이 바인딩을 주입한다.
  // production만 정적이라 여기 적는다 — 세 경로의 모양을 맞춰 둔다.
  "d1_databases": [
    {
      "binding": "BILLING_DB",
      "database_name": "on-my-way-billing-production",
      "database_id": "e32e3083-3956-43c5-8348-f94b1af9d211",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "AI_RATE_LIMITER",
      "namespace_id": "48117",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "triggers": {
    "crons": ["15 0 * * *"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ENERGY_LEDGER",
        "class_name": "EnergyLedgerObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "guest-plan-drafts-v1",
      "new_sqlite_classes": ["GuestPlanDraftObject"]
    },
    {
      "tag": "energy-ledger-v1",
      "new_sqlite_classes": ["EnergyLedgerObject"]
    },
    {
      "tag": "guest-plan-drafts-v2-deleted",
      "deleted_classes": ["GuestPlanDraftObject"]
    }
  ]
}
